# /etc/jev-trader/env
# Install as root:0600. Do not commit a filled-in copy.
# These keys MUST be a Bitfinex sub-account created for this market maker.
# The directional trader on the main account uses different keys and is not touched.

BFX_SUB_API_KEY=
BFX_SUB_API_SECRET=
TYPESAFE_API_KEY=

JEV_BFX__SYMBOL=tBTCF0:USTF0
JEV_BFX__MARKET=perp
JEV_BFX__LEVERAGE=1
JEV_BLOCK_MS=1000
JEV_RISK__MAX_POSITION=0.0004
JEV_RISK__MAX_ORDER_SIZE=0.0004
JEV_RISK__MAX_DAILY_LOSS=10
JEV_RISK__MAX_DRAWDOWN=0.05
JEV_RISK__MAX_STALE_DATA_AGE_S=20
JEV_RISK__MAX_API_ERRORS=5
JEV_RISK__MAX_INVENTORY_AGE_S=300
JEV_LOG_PATH=/var/lib/jev-trader/calibration.jsonl
JEV_FILLS_PATH=/var/lib/jev-trader/fills.jsonl
