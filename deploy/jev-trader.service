[Unit]
Description=jev-trader Bitfinex market maker (dedicated sub-account only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jev
Group=jev
WorkingDirectory=/opt/jev-trader
EnvironmentFile=/etc/jev-trader/env
ExecStart=/opt/jev-trader/.venv/bin/jev-trader live --symbol tBTCF0:USTF0 --max-notional 50
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
