# TypeSafe / Jev
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Loop
JEV_BLOCK_MS=300
JEV_DECISION_TIMEOUT_S=0.25
JEV_CALIBRATION_HORIZON_BLOCKS=10
JEV_LOG_PATH=data/calibration.jsonl

# Paper venue
JEV_STARTING_CASH=10000
JEV_FEE_BPS=1.0

# Hard risk limits (absolute veto, never delegated to Jev)
JEV_RISK__MAX_POSITION=100
JEV_RISK__MAX_ORDER_SIZE=25
JEV_RISK__MAX_DAILY_LOSS=250
JEV_RISK__MAX_DRAWDOWN=0.05
JEV_RISK__MAX_INVENTORY_AGE_S=900
JEV_RISK__MAX_STALE_DATA_AGE_S=2.0
JEV_RISK__MAX_DECISION_LATENCY_MS=250
JEV_RISK__MAX_API_ERRORS=5
# Quote-currency cap. The live command requires --max-notional, which overrides this.
JEV_RISK__MAX_NOTIONAL=0

# Bitfinex dedicated sub-account. Never put the main-account keys here.
# Leave these blank in git. Export them in the systemd EnvironmentFile (mode 0600).
BFX_SUB_API_KEY=
BFX_SUB_API_SECRET=
JEV_BFX__SYMBOL=tBTCF0:USTF0
JEV_BFX__MARKET=perp
JEV_BFX__LEVERAGE=1
# Optional overrides (decimal rates). Empty uses the account summary, then a conservative default.
# JEV_BFX__MAKER_FEE_RATE=0.0002
# JEV_BFX__TAKER_FEE_RATE=0.0065
JEV_BFX__RECONCILE_INTERVAL_S=30
JEV_BFX__MAX_BLIND_S=30
JEV_FILLS_PATH=data/fills.jsonl

# Policy thresholds (code-owned, never in the model)
JEV_POLICY__TOXIC_PULL=0.60
JEV_POLICY__LIQUIDITY_WIDEN=0.70
JEV_POLICY__QUOTE_MIN_SCORE=2.0
JEV_POLICY__QUOTE_MIN_CONFIDENCE=0.80
JEV_POLICY__QUOTE_WIDE_MIN_SCORE=1.0
JEV_POLICY__LOW_CONFIDENCE_SCALE=0.5
